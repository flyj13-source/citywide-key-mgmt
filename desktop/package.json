{
  "name": "citywide-kms-desktop",
  "version": "1.0.0",
  "description": "City Wide Boston KMS — offline Windows desktop app (Electron)",
  "author": "City Wide Facility Solutions Boston",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
