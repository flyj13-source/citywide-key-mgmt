JWT_SECRET=citywide-boston-dev-secret-change-in-production
ENCRYPTION_KEY=6369747977696465626f73746f6e6b657976617532303234212121
ANTHROPIC_API_KEY=your-key-here
SMTP_USER=cara@citywideboston.com
SMTP_PASS=your-app-password
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook

# Second recipient on every key check-out / check-in notification (alongside the
# holder). Falls back to SMTP_USER when unset.
CARA_EMAIL=cara@citywideboston.com

# Public base URL used to build the 48h key sign-off magic link that goes out in
# the check-out email:  ${FRONTEND_URL}/key-signoff/<token>
FRONTEND_URL=http://localhost:5173
LOCAL_ONEDRIVE_PATH=/Users/cara/OneDrive/CityWide Reports
PORT=3001

# Dedicated test/troubleshooting account (Cinch IT). The account is created ONLY
# when TEST_USER_PASSWORD is set — leave it unset to skip creation. Never Cara's.
# Used by the persistence gauntlet (npm run persist:*).
TEST_USER_EMAIL=test@citywideboston.com
TEST_USER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# AUTOMATED BACKUPS  (see handoff/BACKUP-RESTORE.md)
# ─────────────────────────────────────────────────────────────────────────────
# Encrypts every backup artifact at rest before it leaves the Render disk.
# REQUIRED in production — the backup refuses to run under the default key when
# NODE_ENV=production. Generate with:  openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# Off-disk destination — S3-compatible object storage. Recommended: Cloudflare
# R2 (cheap, no egress fees, S3 API). Works unchanged with Backblaze B2 or AWS
# S3 (set BACKUP_S3_REGION for AWS). Leave blank to run "local-only" (no upload).
BACKUP_S3_ENDPOINT=          # e.g. https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=            # e.g. citywide-kms-backups
BACKUP_S3_KEY=               # R2/B2/S3 access key id
BACKUP_S3_SECRET=            # R2/B2/S3 secret access key
# BACKUP_S3_REGION=auto      # 'auto' for R2; real region for AWS S3
# BACKUP_S3_PREFIX=          # optional key prefix inside the bucket

# Retention (defaults 30 daily / 12 monthly if unset)
# BACKUP_RETAIN_DAILY=30
# BACKUP_RETAIN_MONTHLY=12

# Where backup-failure alerts go (falls back to SMTP_USER). SMTP_* must be set.
BACKUP_ALERT_EMAIL=tye@citywideboston.com

# Shared secret the Render Cron Job uses to trigger a backup on the web service
# (POST /api/backups/run). Set the SAME value on BOTH the web service and the
# cron service. Generate with:  openssl rand -hex 32
BACKUP_TRIGGER_TOKEN=

# Set ONLY on the cron service — the URL it POSTs to trigger the backup:
# BACKUP_TRIGGER_URL=https://citywide-backend-0xuj.onrender.com/api/backups/run
