{
  "name": "citywide-key-mgmt-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node database/seed.ts",
    "encrypt-seed": "ts-node database/encrypt-seed.ts",
    "reset-password": "ts-node src/scripts/reset-password.ts",
    "force-reset": "ts-node src/scripts/force-reset.ts",
    "test-user:disable": "ts-node src/scripts/disable-test-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "persist:check": "ts-node scripts/persistence-check.ts write",
    "persist:verify": "ts-node scripts/persistence-check.ts verify",
    "persist:snapshot": "ts-node scripts/persistence-check.ts snapshot",
    "gauntlet:write": "ts-node scripts/gauntlet.ts write",
    "gauntlet:verify": "ts-node scripts/gauntlet.ts verify",
    "gauntlet:full": "ts-node scripts/gauntlet.ts full",
    "gauntlet:cleanup": "ts-node scripts/gauntlet.ts cleanup",
    "report:backfill": "ts-node scripts/report-backfill-dry-run.ts",
    "backup": "ts-node scripts/backup.ts",
    "backup:test": "ts-node scripts/backup-test.ts",
    "backup:restore": "ts-node scripts/restore.ts",
    "backup:trigger": "ts-node scripts/trigger-backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.20",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "vitest": "^2.1.9"
  }
}
